# Written by scripts/deploy.sh; edit and `sudo systemctl restart can-proxyd`.
# Read by can-proxy-links.service (interfaces) and can-proxyd.service.
#
# Bench with the emulator on the same box (car-can-emulator.service on vcan1):
CONTRACT_IF=vcan0
VEHICLE_IF=vcan1
PLUGIN=emu-ev
PLUGIN_ARGS=--plugin-arg source=emulator
#
# A real car on a CANable dongle:
#CONTRACT_IF=vcan0
#VEHICLE_IF=can0
#VEHICLE_BITRATE=500000
#PLUGIN=obd2-ice
#PLUGIN_ARGS=--plugin-arg source=live
#
# Anything else for can-proxyd, e.g. --record=/home/pi/session.log --log-level=debug
EXTRA_ARGS=
